<div class="rip-n-tear-container {{themeClass}}" data-actor-id="{{actor.id}}">
   <div class="rnt-block">
      <div class="rnt-block-header">
         <h4><i class="fa-solid fa-bone"></i> {{localize "pf2e-aztecs-rip-n-tear.title"}}</h4>
         <div class="rnt-block-actions">
            <a class="rnt-add-part" data-tooltip="{{localize 'pf2e-aztecs-rip-n-tear.addBodyPart'}}"><i class="fa-solid fa-plus"></i></a>
            <a class="rnt-hide-npc" data-tooltip="{{localize 'pf2e-aztecs-rip-n-tear.hideMainNpc'}}"><i class="fa-solid fa-arrows-to-eye"></i></a>
            <a class="rnt-import-part" data-tooltip="{{localize 'pf2e-aztecs-rip-n-tear.importBodyPart'}}"><i class="fa-solid fa-file-import"></i></a>
            <a class="rnt-templates-menu" data-tooltip="{{localize 'pf2e-aztecs-rip-n-tear.templatesMenu'}}"><i class="fa-solid fa-puzzle-piece"></i></a>
         </div>
      </div>
      <div class="rnt-block-body">
         {{#each parts as |part|}}
         <div class="rnt-item-card item action {{#if part.isHidden}}rnt-hidden-part{{/if}}" data-part-id="{{part.id}}">
            <div class="rnt-item-row">
               <div class="rnt-item-name">
                  <img src="{{part.img}}" style="width: 24px; height: 24px; border: 1px solid var(--color-border-dark); margin-right: 6px; object-fit: contain; border-radius: 2px;" title="{{part.name}}" />
                  <a class="rnt-name name">{{part.name}}</a>
                  <span class="rnt-hp-block">
                     {{#if part.useRupture}}
                     <i class="fa-solid fa-heart" data-tooltip="{{localize 'pf2e-aztecs-rip-n-tear.ruptureThreshold'}}"></i>
                     {{else}}
                     <i class="fa-solid fa-heart"></i>
                     {{/if}}
                     <input type="number" class="rnt-hp-input" value="{{part.hp.value}}" />
                     <span class="rnt-text-muted">/ {{part.hp.max}}</span>
                  </span>
                  <span class="rnt-hp-state" style="color: {{part.hpColor}};">{{part.hpText}}</span>
                  
                  <div class="rnt-item-link-icons">
                     {{#if part.hasSpellcastingLinks}}
                     <i class="fa-solid fa-wand-magic-sparkles rnt-view-links" data-part-id="{{part.id}}" data-link-type="spells" data-tooltip="{{localize 'pf2e-aztecs-rip-n-tear.linkedSpellcasting'}}"></i>
                     {{/if}}
                     {{#if part.hasAbilityLinks}}
                     <i class="fa-solid fa-suitcase rnt-view-links" data-part-id="{{part.id}}" data-link-type="abilities" data-tooltip="{{localize 'pf2e-aztecs-rip-n-tear.linkedAbilitiesShort'}}"></i>
                     {{/if}}
                     {{#if part.hasModuleLinks}}
                     <i class="fa-solid fa-gears rnt-view-links" data-part-id="{{part.id}}" data-link-type="modules" data-tooltip="{{localize 'pf2e-aztecs-rip-n-tear.linkedModules'}}"></i>
                     {{/if}}
                  </div>
               </div>
               
               <div class="rnt-item-controls controls">
                  <a class="rnt-toggle-hidden" data-part-id="{{part.id}}" data-tooltip="{{localize 'pf2e-aztecs-rip-n-tear.toggleHide'}}"><i class="fa-solid fa-eye{{#if part.isHidden}}-slash{{/if}}"></i></a>
                  <a class="rnt-heal-part rnt-control-success" data-part-id="{{part.id}}" data-tooltip="{{localize 'pf2e-aztecs-rip-n-tear.healBtn'}}"><i class="fa-solid fa-heart-circle-plus"></i></a>
                  <a class="rnt-damage-part rnt-control-danger" data-part-id="{{part.id}}" data-tooltip="{{localize 'pf2e-aztecs-rip-n-tear.damageBtn'}}"><i class="fa-solid fa-heart-crack"></i></a>
                  <a class="rnt-edit-part" data-part-id="{{part.id}}" data-tooltip="{{localize 'pf2e-aztecs-rip-n-tear.edit'}}"><i class="fa-solid fa-edit"></i></a>
                  <a class="rnt-copy-part" data-part-id="{{part.id}}" data-tooltip="{{localize 'pf2e-aztecs-rip-n-tear.copy'}}"><i class="fa-solid fa-copy"></i></a>
                  <a class="rnt-export-part" data-part-id="{{part.id}}" data-tooltip="{{localize 'pf2e-aztecs-rip-n-tear.export'}}"><i class="fa-solid fa-file-export"></i></a>
                  <a class="rnt-delete-part rnt-control-danger" data-part-id="{{part.id}}" data-tooltip="{{localize 'pf2e-aztecs-rip-n-tear.delete'}}"><i class="fa-solid fa-trash"></i></a>
               </div>
            </div>
            <div class="rnt-item-summary item-summary" hidden>
               {{{part.summaryHtml}}}
            </div>
         </div>
         {{else}}
         <div class="rnt-empty">{{localize "pf2e-aztecs-rip-n-tear.noBodyParts"}}</div>
         {{/each}}
      </div>
   </div>

   <div class="rnt-block">
      <div class="rnt-block-header">
         <h4><i class="fa-solid fa-bolt"></i> {{localize "pf2e-aztecs-rip-n-tear.damageReactions"}}</h4>
         <div class="rnt-block-actions">
            <a class="rnt-add-reaction" data-tooltip="{{localize 'pf2e-aztecs-rip-n-tear.addReaction'}}"><i class="fa-solid fa-plus"></i></a>
            <a class="rnt-import-reaction" data-tooltip="{{localize 'pf2e-aztecs-rip-n-tear.importReaction'}}"><i class="fa-solid fa-file-import"></i></a>
         </div>
      </div>
      <div class="rnt-block-body">
         {{#each reactions as |rx|}}
         <div class="rnt-item-card item action {{#if rx.disabled}}rnt-disabled{{/if}}" data-reaction-id="{{rx.id}}">
            <div class="rnt-item-row">
               <div class="rnt-item-name">
                  <a class="rnt-reaction-name name">{{rx.name}}</a>
                  <span class="rnt-item-meta">
                     {{#if rx.minDamage}}{{rx.minDamage}}+ {{localize "pf2e-aztecs-rip-n-tear.damage"}} / {{/if}}
                     {{#if rx.damageTypes.length}}
                     {{#each rx.damageTypes}}{{this}}{{#unless @last}}, {{/unless}}{{/each}}
                     {{else}}
                     {{localize "pf2e-aztecs-rip-n-tear.anyType"}}
                     {{/if}}
                  </span>
               </div>
               <div class="rnt-item-controls controls">
                  <a class="rnt-toggle-reaction {{#if rx.disabled}}rnt-toggle-off{{else}}rnt-toggle-on{{/if}}" data-reaction-id="{{rx.id}}" data-tooltip="{{localize 'pf2e-aztecs-rip-n-tear.toggle'}}"><i class="fa-solid fa-power-off"></i></a>
                  <a class="rnt-trigger-reaction" data-reaction-id="{{rx.id}}" data-tooltip="{{localize 'pf2e-aztecs-rip-n-tear.trigger'}}"><i class="fa-solid fa-play"></i></a>
                  <a class="rnt-edit-reaction" data-reaction-id="{{rx.id}}" data-tooltip="{{localize 'pf2e-aztecs-rip-n-tear.edit'}}"><i class="fa-solid fa-edit"></i></a>
                  <a class="rnt-copy-reaction" data-reaction-id="{{rx.id}}" data-tooltip="{{localize 'pf2e-aztecs-rip-n-tear.copy'}}"><i class="fa-solid fa-copy"></i></a>
                  <a class="rnt-export-reaction" data-reaction-id="{{rx.id}}" data-tooltip="{{localize 'pf2e-aztecs-rip-n-tear.export'}}"><i class="fa-solid fa-file-export"></i></a>
                  <a class="rnt-delete-reaction rnt-control-danger" data-reaction-id="{{rx.id}}" data-tooltip="{{localize 'pf2e-aztecs-rip-n-tear.delete'}}"><i class="fa-solid fa-trash"></i></a>
               </div>
            </div>
            <div class="rnt-item-summary item-summary" hidden>
               {{{rx.summaryHtml}}}
            </div>
         </div>
         {{else}}
         <div class="rnt-empty">{{localize "pf2e-aztecs-rip-n-tear.noDamageReactions"}}</div>
         {{/each}}
      </div>
   </div>

   <div class="rnt-block">
      <div class="rnt-block-header">
         <h4><i class="fa-solid fa-skull"></i> {{localize "pf2e-aztecs-rip-n-tear.deathReaction"}}</h4>
         <div class="rnt-block-actions">
            {{#unless deathReaction}}
            <a class="rnt-add-death-reaction" data-tooltip="{{localize 'pf2e-aztecs-rip-n-tear.addDeathReaction'}}"><i class="fa-solid fa-plus"></i></a>
            <a class="rnt-import-death-reaction" data-tooltip="{{localize 'pf2e-aztecs-rip-n-tear.importDeathReaction'}}"><i class="fa-solid fa-file-import"></i></a>
            {{/unless}}
         </div>
      </div>
      <div class="rnt-block-body">
         {{#if deathReaction}}
         <div class="rnt-item-card item action {{#if deathReaction.disabled}}rnt-disabled{{/if}}" data-death-reaction-id="{{deathReaction.id}}">
            <div class="rnt-item-row">
               <div class="rnt-item-name">
                  <a class="rnt-death-reaction-name name">{{deathReaction.name}}</a>
                  {{#if deathReaction.useDelay}}
                  <span class="rnt-item-meta">{{localize "pf2e-aztecs-rip-n-tear.delayedShort"}} {{deathReaction.delayRounds}} {{#if (eq deathReaction.delayRounds 1)}}{{localize "pf2e-aztecs-rip-n-tear.roundOne"}}{{else}}{{localize "pf2e-aztecs-rip-n-tear.rounds"}}{{/if}}</span>
                  {{/if}}
               </div>
               <div class="rnt-item-controls controls">
                  <a class="rnt-toggle-death-reaction {{#if deathReaction.disabled}}rnt-toggle-off{{else}}rnt-toggle-on{{/if}}" data-tooltip="{{localize 'pf2e-aztecs-rip-n-tear.toggle'}}"><i class="fa-solid fa-power-off"></i></a>
                  <a class="rnt-trigger-death-reaction" data-tooltip="{{localize 'pf2e-aztecs-rip-n-tear.trigger'}}"><i class="fa-solid fa-play"></i></a>
                  <a class="rnt-edit-death-reaction" data-tooltip="{{localize 'pf2e-aztecs-rip-n-tear.edit'}}"><i class="fa-solid fa-edit"></i></a>
                  <a class="rnt-export-death-reaction" data-tooltip="{{localize 'pf2e-aztecs-rip-n-tear.export'}}"><i class="fa-solid fa-file-export"></i></a>
                  <a class="rnt-delete-death-reaction rnt-control-danger" data-tooltip="{{localize 'pf2e-aztecs-rip-n-tear.delete'}}"><i class="fa-solid fa-trash"></i></a>
               </div>
            </div>
            <div class="rnt-item-summary item-summary" hidden>
               {{{deathReaction.summaryHtml}}}
            </div>
         </div>
         {{else}}
         <div class="rnt-empty">{{localize "pf2e-aztecs-rip-n-tear.noDeathReaction"}}</div>
         {{/if}}
      </div>
   </div>
</div>

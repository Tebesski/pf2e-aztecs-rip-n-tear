<div class="rnt-chat-card pf2e chat-card">
   <header class="rnt-chat-card-header">
      <i class="fa-solid fa-crosshairs"></i>
      {{targetName}}
      <span style="margin-left: 4px;">[{{partName}}]</span>
   </header>

   <div class="card-content">
      <div
         style="font-weight: 700; padding-bottom: 4px; border-bottom: 1px solid rgba(0,0,0,0.15); margin-bottom: 4px;"
      >{{localize "pf2e-aztecs-rip-n-tear.damageBreakdown"}}</div>
      {{#each damages}}
         <div
            class="rnt-chat-card-row dice-formula"
            style="background: transparent; border: none; box-shadow: none; padding: 0;"
         >
            <span
               style="text-transform: capitalize; font-weight: 500;"
            >{{this.label}}</span>
            <span
               class="{{this.dmgType}} damage instance color"
               data-tooltip="{{this.tooltip}}"
               style="margin: 0;"
            >
               {{this.amount}}
               {{#if this.isPersistent}}
                  <i class="fa-duotone fa-hourglass icon" inert></i>
               {{/if}}
               <i class="{{this.icon}} icon" inert></i>
            </span>
         </div>
      {{/each}}
      {{#if totalDamage}}
         <div
            class="rnt-chat-card-row"
            style="border-top: 1px solid rgba(0,0,0,0.2); padding-top: 4px; margin-top: 4px; font-weight: 700; font-size: 1.05em;"
         >
            <span>{{localize "pf2e-aztecs-rip-n-tear.totalDamage"}}</span>
            <span style="color: var(--rnt-accent);">{{totalDamage}}</span>
         </div>
      {{/if}}
   </div>

   <div class="rnt-chat-card-actions">
      <button
         type="button"
         class="rnt-chat-btn"
         data-action="rnt-apply-damage"
         data-multiplier="1"
         data-part-id="{{partId}}"
      >
         <i class="fa-solid fa-heart-crack"></i>
         {{localize "pf2e-aztecs-rip-n-tear.damage"}}
      </button>
      <button
         type="button"
         class="rnt-chat-btn"
         data-action="rnt-apply-damage"
         data-multiplier="0.5"
         data-part-id="{{partId}}"
      >
         <i class="fa-solid fa-heart-crack"></i>
         {{localize "pf2e-aztecs-rip-n-tear.half"}}
      </button>
      <button
         type="button"
         class="rnt-chat-btn"
         data-action="rnt-apply-damage"
         data-multiplier="2"
         data-part-id="{{partId}}"
      >
         <i class="fa-solid fa-explosion"></i>
         {{localize "pf2e-aztecs-rip-n-tear.double"}}
      </button>
   </div>
</div>
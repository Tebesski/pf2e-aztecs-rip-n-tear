<form autocomplete="off" onsubmit="event.preventDefault();">
<div class="rnt-scrollable">

   <div class="rnt-identity">
      <div class="rnt-identity-row">
         <div class="rnt-identity-name" style="display: flex; gap: 8px; align-items: center;">
            <img src="{{part.img}}" data-action="pickPartIcon" style="width: 32px; height: 32px; cursor: pointer; object-fit: contain; border: 1px solid var(--color-border-dark);" title="Click to change icon" />
            <input type="hidden" name="img" value="{{part.img}}" />
            <input type="text" name="name" value="{{part.name}}" placeholder="{{localize 'pf2e-aztecs-rip-n-tear.bodyPartNamePh'}}" style="flex: 1;" />
         </div>
         <div class="rnt-identity-hp">
            <i class="fa-solid fa-heart" style="color: var(--rnt-accent);"></i>
            <input type="number" name="hp.value" value="{{part.hp.value}}" />
            <span style="color: var(--rnt-text-muted);">/</span>
            <input type="number" name="hp.max" value="{{part.hp.max}}" />
         </div>
         <label class="rnt-identity-rupture">
            <input type="checkbox" name="useRupture" {{checked part.useRupture}} />
            Rupture
            <i class="fa-solid fa-circle-info rnt-info" data-tooltip="{{localize 'pf2e-aztecs-rip-n-tear.ruptureTooltip'}}"></i>
         </label>
      </div>

      <div class="rnt-identity-acrow">
         <div class="rnt-identity-acitem">
            <label>{{localize "pf2e-aztecs-rip-n-tear.acAdjustment"}} <i class="fa-solid fa-circle-info rnt-info" data-tooltip="{{localize 'pf2e-aztecs-rip-n-tear.acAdjustmentTooltip'}}"></i></label>
            <div style="display: flex; align-items: center; gap: 4px;">
               <input type="number" class="rnt-ac-adj-input" name="acAdjustment" value="{{part.acAdjustment}}" data-base-ac="{{@root.actor.system.attributes.ac.value}}" data-old-ac="{{part.ac}}" style="max-width: 60px;" />
               <span style="color: var(--rnt-text-muted); white-space: nowrap; font-weight: 600;" class="rnt-ac-total-display"></span>
            </div>
         </div>
         <div class="rnt-identity-acitem">
            <label>{{localize "pf2e-aztecs-rip-n-tear.hardness"}}</label>
            <input type="number" name="hardness" value="{{part.hardness}}" />
         </div>
      </div>

      <div class="rnt-saves-inline">
         <div class="rnt-save-inline {{#if part.saves.fortitude.enabled}}rnt-save-active{{/if}}" style="display: flex; align-items: center; gap: 4px;">
            <input type="checkbox" name="saves.fortitude.enabled" {{checked part.saves.fortitude.enabled}}>
            <label>Fortitude</label>
            <input type="number" class="rnt-save-adj-input" name="saves.fortitude.adjustment" value="{{part.saves.fortitude.adjustment}}" data-base-save="{{@root.actor.saves.fortitude.mod}}" style="max-width: 50px;">
            <span class="rnt-save-total-display" style="color: var(--rnt-text-muted); font-weight: 600;"></span>
         </div>
         <div class="rnt-save-inline {{#if part.saves.reflex.enabled}}rnt-save-active{{/if}}" style="display: flex; align-items: center; gap: 4px;">
            <input type="checkbox" name="saves.reflex.enabled" {{checked part.saves.reflex.enabled}}>
            <label>Reflex</label>
            <input type="number" class="rnt-save-adj-input" name="saves.reflex.adjustment" value="{{part.saves.reflex.adjustment}}" data-base-save="{{@root.actor.saves.reflex.mod}}" style="max-width: 50px;">
            <span class="rnt-save-total-display" style="color: var(--rnt-text-muted); font-weight: 600;"></span>
         </div>
         <div class="rnt-save-inline {{#if part.saves.will.enabled}}rnt-save-active{{/if}}" style="display: flex; align-items: center; gap: 4px;">
            <input type="checkbox" name="saves.will.enabled" {{checked part.saves.will.enabled}}>
            <label>Will</label>
            <input type="number" class="rnt-save-adj-input" name="saves.will.adjustment" value="{{part.saves.will.adjustment}}" data-base-save="{{@root.actor.saves.will.mod}}" style="max-width: 50px;">
            <span class="rnt-save-total-display" style="color: var(--rnt-text-muted); font-weight: 600;"></span>
         </div>
      </div>
   </div>

   <details class="rnt-section" data-section="damageBehaviour">
      <summary class="rnt-section-title rnt-summary-flex" style="cursor: pointer;">
         <span class="rnt-chevron-wrapper"><i class="fa-solid fa-chevron-right rnt-chevron-icon"></i></span>
         <span style="flex: 1;">{{localize "pf2e-aztecs-rip-n-tear.damageBehaviour"}}</span>
      </summary>
      <div class="rnt-field">
         <label class="rnt-field-label">
            {{localize "pf2e-aztecs-rip-n-tear.regrowth"}}
            <i class="fa-solid fa-circle-info rnt-info" data-tooltip="{{localize 'pf2e-aztecs-rip-n-tear.regrowthTooltip'}}"></i>
         </label>
         <div class="rnt-field-control">
            <input type="checkbox" name="regrowth.enabled" onchange="this.closest('.rnt-section').querySelector('.rnt-regrowth-stack').style.display = this.checked ? '' : 'none';" {{checked part.regrowth.enabled}} />
         </div>
      </div>

      <div class="rnt-field rnt-field-stack rnt-regrowth-stack" {{#unless part.regrowth.enabled}}style="display: none;"{{/unless}}>
         <div class="rnt-input-group">
            <label>
               <input type="checkbox" name="regrowth.full" onchange="this.closest('.rnt-input-group').querySelector('.rnt-regrowth-amount').style.display = this.checked ? 'none' : '';" {{checked part.regrowth.full}} />
               {{localize "pf2e-aztecs-rip-n-tear.fullHeal"}}
               <i class="fa-solid fa-circle-info rnt-info" data-tooltip="{{localize 'pf2e-aztecs-rip-n-tear.fullHealTooltip'}}"></i>
            </label>
            <input type="number" class="rnt-regrowth-amount" name="regrowth.amount" value="{{part.regrowth.amount}}" placeholder="{{localize 'pf2e-aztecs-rip-n-tear.regrowthAmount'}}" {{#if part.regrowth.full}}style="display: none;"{{/if}} />
         </div>
      </div>

      <div class="rnt-field">
         <label class="rnt-field-label">{{localize "pf2e-aztecs-rip-n-tear.dealsDamageToCreature"}}</label>
         <div class="rnt-field-control"><input type="checkbox" name="dealsDamage" {{checked part.dealsDamage}} /></div>
      </div>
      <div class="rnt-field rnt-persistent-dmg-group" {{#unless part.dealsDamage}}style="display:none;"{{/unless}}>
         <label class="rnt-field-label">{{localize "pf2e-aztecs-rip-n-tear.persistentDealsDmg"}}</label>
         <div class="rnt-field-control"><input type="checkbox" name="persistentDealsDamage" {{checked part.persistentDealsDamage}} /></div>
      </div>
      {{#if part.useRupture}}
      <div class="rnt-field rnt-failed-rupture-group" {{#unless part.dealsDamage}}style="display:none;"{{/unless}}>
         <label class="rnt-field-label">{{localize "pf2e-aztecs-rip-n-tear.failedRuptureDealsDmg"}} 
         <i class="fa-solid fa-circle-info rnt-info" data-tooltip="{{localize 'pf2e-aztecs-rip-n-tear.failedRuptureDealsDmgTooltip'}}"></i></label>
         <div class="rnt-field-control"><input type="checkbox" name="failedRuptureDealsDamage" {{checked part.failedRuptureDealsDamage}} /></div>
      </div>
      {{/if}}
      <div class="rnt-field">
         <label class="rnt-field-label">{{localize "pf2e-aztecs-rip-n-tear.damageMultiplier"}}</label>
         <div class="rnt-field-control"><input type="number" step="0.1" name="multiplier" value="{{part.multiplier}}" /></div>
      </div>
      <div class="rnt-field">
         <label class="rnt-field-label">{{localize "pf2e-aztecs-rip-n-tear.removeEffectsOnFullHeal"}} <i class="fa-solid fa-circle-info rnt-info" data-tooltip="{{localize 'pf2e-aztecs-rip-n-tear.removeEffectsTooltip'}}"></i></label>
         <div class="rnt-field-control"><input type="checkbox" name="removeEffectsOnFullHeal" {{checked part.removeEffectsOnFullHeal}} /></div>
      </div>
   </details>

   <details class="rnt-section" data-section="acceptedDmgTypes">
      <summary class="rnt-section-title rnt-summary-flex" style="cursor: pointer;">
         <span class="rnt-chevron-wrapper"><i class="fa-solid fa-chevron-right rnt-chevron-icon"></i></span>
         <span style="flex: 1;">{{localize "pf2e-aztecs-rip-n-tear.acceptedDmgTypes"}} <i class="fa-solid fa-circle-info rnt-info" data-tooltip="{{localize 'pf2e-aztecs-rip-n-tear.acceptedDmgTypesTooltip'}}"></i></span>
      </summary>
      <select name="acceptedDmgTypesSelect">
         <option value="" disabled selected>{{localize "pf2e-aztecs-rip-n-tear.addDmgType"}}</option>
         {{#each availableAcceptedDmgTypes as |dt|}}
         <option value="{{dt.slug}}">{{dt.label}}</option>
         {{/each}}
       </select>
       <div class="rnt-chip-list">
         {{#each acceptedDmgTypeChips as |dt|}}
         <span class="rnt-chip">
            {{dt.label}}
            <input type="hidden" name="acceptedDmgTypes" value="{{dt.slug}}">
            <a class="rnt-chip-remove" data-action="removeAcceptedDmgType" data-slug="{{dt.slug}}"><i class="fa-solid fa-times"></i></a>
         </span>
         {{/each}}
      </div>
   </details>

   <details class="rnt-section" data-section="customIWR">
      <summary class="rnt-section-title rnt-summary-flex" style="cursor: pointer;">
         <span class="rnt-chevron-wrapper"><i class="fa-solid fa-chevron-right rnt-chevron-icon"></i></span>
         <input type="checkbox" name="customIWR" {{checked part.customIWR}} style="margin-right: 6px;">
         <span style="flex: 1;">{{localize "pf2e-aztecs-rip-n-tear.overrideIWR"}}</span>
      </summary>
{{#if part.customIWR}}
      <div class="rnt-field rnt-field-stack">
         <label class="rnt-field-label">{{localize "pf2e-aztecs-rip-n-tear.immunities"}}</label>
         <select id="rnt-immune-select"><option value="" disabled selected>{{localize "pf2e-aztecs-rip-n-tear.addImmunity"}}</option>{{#each pf2eIWRTypes}}<option value="{{this.slug}}">{{this.label}}</option>{{/each}}</select>
         <div class="rnt-chip-list">
            {{#each part.iwrData.immune}}
            <span class="rnt-chip">{{this.label}}<a class="rnt-chip-remove" data-action="removeImmunity" data-raw="{{this.raw}}"><i class="fa-solid fa-times"></i></a></span>
            {{/each}}
         </div>
         
         <select id="rnt-immune-exc-select" style="margin-top: 4px;"><option value="" disabled selected>{{localize "pf2e-aztecs-rip-n-tear.addException"}}</option>{{#each pf2eIWRTypes}}<option value="{{this.slug}}">{{this.label}}</option>{{/each}}</select>
         <div class="rnt-chip-list">
            {{#each part.iwrData.immuneExc}}
            <span class="rnt-chip">{{this.label}}<a class="rnt-chip-remove" data-action="removeImmuneExc" data-raw="{{this.raw}}"><i class="fa-solid fa-times"></i></a></span>
            {{/each}}
         </div>

         <input type="hidden" name="iwr.immune" value="{{part.iwr.immune}}" />
         <input type="hidden" name="iwr.immuneExc" value="{{part.iwr.immuneExc}}" />
      </div>
      <div class="rnt-field rnt-field-stack">
         <label class="rnt-field-label">{{localize "pf2e-aztecs-rip-n-tear.weaknesses"}}</label>
         <div class="rnt-input-group">
            <select id="rnt-weak-select"><option value="" disabled selected>{{localize "pf2e-aztecs-rip-n-tear.addWeakness"}}</option>{{#each pf2eIWRTypes}}<option value="{{this.slug}}">{{this.label}}</option>{{/each}}</select>
            <input type="number" id="rnt-weak-value" value="5" placeholder="{{localize 'pf2e-aztecs-rip-n-tear.valShort'}}" style="flex: 0 0 50px;" />
         </div>
         <div class="rnt-chip-list">
            {{#each part.iwrData.weak}}
            <span class="rnt-chip">{{this.label}}<a class="rnt-chip-remove" data-action="removeWeakness" data-raw="{{this.raw}}"><i class="fa-solid fa-times"></i></a></span>
            {{/each}}
         </div>

         <select id="rnt-weak-exc-select" style="margin-top: 4px;"><option value="" disabled selected>{{localize "pf2e-aztecs-rip-n-tear.addException"}}</option>{{#each pf2eIWRTypes}}<option value="{{this.slug}}">{{this.label}}</option>{{/each}}</select>
         <div class="rnt-chip-list">
            {{#each part.iwrData.weakExc}}
            <span class="rnt-chip">{{this.label}}<a class="rnt-chip-remove" data-action="removeWeakExc" data-raw="{{this.raw}}"><i class="fa-solid fa-times"></i></a></span>
            {{/each}}
         </div>

         <input type="hidden" name="iwr.weak" value="{{part.iwr.weak}}" />
         <input type="hidden" name="iwr.weakExc" value="{{part.iwr.weakExc}}" />
      </div>
      <div class="rnt-field rnt-field-stack">
         <label class="rnt-field-label">{{localize "pf2e-aztecs-rip-n-tear.resistances"}}</label>
         <div class="rnt-input-group">
            <select id="rnt-resist-select"><option value="" disabled selected>{{localize "pf2e-aztecs-rip-n-tear.addResistance"}}</option>{{#each pf2eIWRTypes}}<option value="{{this.slug}}">{{this.label}}</option>{{/each}}</select>
            <input type="number" id="rnt-resist-value" value="5" placeholder="{{localize 'pf2e-aztecs-rip-n-tear.valShort'}}" style="flex: 0 0 50px;" />
         </div>
         <div class="rnt-chip-list">
            {{#each part.iwrData.resist}}
            <span class="rnt-chip">{{this.label}}<a class="rnt-chip-remove" data-action="removeResistance" data-raw="{{this.raw}}"><i class="fa-solid fa-times"></i></a></span>
            {{/each}}
         </div>

         <select id="rnt-resist-exc-select" style="margin-top: 4px;"><option value="" disabled selected>{{localize "pf2e-aztecs-rip-n-tear.addException"}}</option>{{#each pf2eIWRTypes}}<option value="{{this.slug}}">{{this.label}}</option>{{/each}}</select>
         <div class="rnt-chip-list">
            {{#each part.iwrData.resistExc}}
            <span class="rnt-chip">{{this.label}}<a class="rnt-chip-remove" data-action="removeResistExc" data-raw="{{this.raw}}"><i class="fa-solid fa-times"></i></a></span>
            {{/each}}
         </div>

         <input type="hidden" name="iwr.resist" value="{{part.iwr.resist}}" />
         <input type="hidden" name="iwr.resistExc" value="{{part.iwr.resistExc}}" />
      </div>
      {{/if}}
   </details>

   <details class="rnt-section" data-section="soundEffects">
      <summary class="rnt-section-title rnt-summary-flex" style="cursor: pointer;">
         <span class="rnt-chevron-wrapper"><i class="fa-solid fa-chevron-right rnt-chevron-icon"></i></span>
         <span style="flex: 1;">{{localize "pf2e-aztecs-rip-n-tear.soundEffects"}}</span>
      </summary>
      <div class="rnt-sfx-field">
         <label>{{localize "pf2e-aztecs-rip-n-tear.sfxDamage"}}</label>
         <input type="text" name="sfxDamage" value="{{part.sfxDamage}}" placeholder="path/to/sound.ogg" />
         <button type="button" class="rnt-btn-icon" data-action="pickFile" data-tooltip="{{localize 'pf2e-aztecs-rip-n-tear.browseFiles'}}"><i class="fa-solid fa-folder-open"></i></button>
         <button type="button" class="rnt-btn-icon" data-action="previewSfx" data-tooltip="{{localize 'pf2e-aztecs-rip-n-tear.preview'}}"><i class="fa-solid fa-play"></i></button>
      </div>
      <div class="rnt-sfx-field">
         <label>{{localize "pf2e-aztecs-rip-n-tear.sfxDestroy"}}</label>
         <input type="text" name="sfxDestroy" value="{{part.sfxDestroy}}" placeholder="path/to/sound.ogg" />
         <button type="button" class="rnt-btn-icon" data-action="pickFile" data-tooltip="{{localize 'pf2e-aztecs-rip-n-tear.browseFiles'}}"><i class="fa-solid fa-folder-open"></i></button>
         <button type="button" class="rnt-btn-icon" data-action="previewSfx" data-tooltip="{{localize 'pf2e-aztecs-rip-n-tear.preview'}}"><i class="fa-solid fa-play"></i></button>
      </div>
      <div class="rnt-sfx-field">
         <label>{{localize "pf2e-aztecs-rip-n-tear.sfxHeal"}}</label>
         <input type="text" name="sfxHeal" value="{{part.sfxHeal}}" placeholder="path/to/sound.ogg" />
         <button type="button" class="rnt-btn-icon" data-action="pickFile" data-tooltip="{{localize 'pf2e-aztecs-rip-n-tear.browseFiles'}}"><i class="fa-solid fa-folder-open"></i></button>
         <button type="button" class="rnt-btn-icon" data-action="previewSfx" data-tooltip="{{localize 'pf2e-aztecs-rip-n-tear.preview'}}"><i class="fa-solid fa-play"></i></button>
      </div>
   </details>

   <details class="rnt-section" data-section="linkedAbilities">
      <summary class="rnt-section-title rnt-summary-flex" style="cursor: pointer;">
         <span class="rnt-chevron-wrapper"><i class="fa-solid fa-chevron-right rnt-chevron-icon"></i></span>
         <span class="rnt-section-title-flex" style="flex: 1;">{{localize "pf2e-aztecs-rip-n-tear.linkedAbilities"}}</span>
         <a class="rnt-action-link" data-action="configSpellcasting"><i class="fa-solid fa-wand-magic-sparkles"></i> {{localize "pf2e-aztecs-rip-n-tear.specificSpells"}}</a>
      </summary>
      <select class="rnt-ability-select">
         <option value="">{{localize "pf2e-aztecs-rip-n-tear.selectAbility"}}</option>
         <optgroup label="{{localize 'pf2e-aztecs-rip-n-tear.attacks'}}">{{#each attacks}}<option value="{{this.id}}">{{this.name}}</option>{{/each}}</optgroup>
         <optgroup label="{{localize 'pf2e-aztecs-rip-n-tear.abilities'}}">{{#each abilities}}<option value="{{this.id}}">{{this.name}}</option>{{/each}}</optgroup>
         <optgroup label="{{localize 'pf2e-aztecs-rip-n-tear.passives'}}">{{#each passives}}<option value="{{this.id}}">{{this.name}}</option>{{/each}}</optgroup>
         <optgroup label="{{localize 'pf2e-aztecs-rip-n-tear.spellcasting'}}"><option value="ALL_SPELLCASTING">{{localize "pf2e-aztecs-rip-n-tear.allSpellcasting"}}</option></optgroup>
      </select>
      {{#if linkedItemsData.length}}
      <div class="rnt-repeat-list">
         {{#each linkedItemsData}}
         <div class="rnt-linked-row">
            {{#if (eq this.id "ALL_SPELLCASTING")}}
            <a class="content-link rnt-link-no-underline"><i class="fa-solid fa-wand-magic-sparkles"></i> {{this.name}}</a>
            {{else}}
            <a class="content-link item-link rnt-link-no-underline" data-id="{{this.id}}"><i class="fa-solid {{#if this.icon}}{{this.icon}}{{else}}fa-suitcase{{/if}}"></i> {{this.name}}</a>
            {{/if}}
            <a class="rnt-repeat-remove" data-action="removeLinkedItem" data-id="{{this.id}}"><i class="fa-solid fa-trash"></i></a>
         </div>
         {{/each}}
      </div>
      {{/if}}
   </details>

   {{#if part.dependentParts.length}}
   <div class="rnt-callout">
      <div class="rnt-callout-title"><i class="fa-solid fa-link"></i> {{localize "pf2e-aztecs-rip-n-tear.dependentBodyParts"}}</div>
      <div class="rnt-callout-body">{{localize "pf2e-aztecs-rip-n-tear.dependentBodyPartsHint"}}</div>
      <div class="rnt-chip-list">
         {{#each part.dependentParts}}
         <a class="rnt-dependent-part-link rnt-chip" data-part-id="{{this.id}}" style="cursor: pointer;"><i class="fa-solid fa-link"></i> {{this.name}}</a>
         {{/each}}
      </div>
   </div>
   {{/if}}

   <div class="rnt-bar-heading">
      <h3><i class="fa-solid fa-layer-group" style="color: var(--rnt-warning);"></i> {{localize "pf2e-aztecs-rip-n-tear.thresholds"}}</h3>
      <a class="rnt-action-link rnt-action-add" data-action="addThreshold"><i class="fa-solid fa-plus"></i> {{localize "pf2e-aztecs-rip-n-tear.addThreshold"}}</a>
   </div>

   <div class="rnt-repeat-list">
      {{#each part.thresholds as |t i|}}
      {{#unless @first}}<hr style="margin: 16px 0; border: none; border-top: 1px solid var(--color-border-dark);">{{/unless}}
      <details class="rnt-threshold-card" data-threshold="{{i}}" open>
         <summary class="rnt-threshold-header rnt-summary-flex" style="cursor: pointer;">
            <label>{{localize "pf2e-aztecs-rip-n-tear.activateAtHp"}}</label>
            <input type="number" class="rnt-input-tiny" name="thresholds.{{i}}.hpValue" value="{{t.hpValue}}" />
            <label style="margin-left: 12px; flex: 1;"><input type="checkbox" name="thresholds.{{i}}.disableAbilities" {{checked t.disableAbilities}}> {{localize "pf2e-aztecs-rip-n-tear.disableAbilities"}}</label>
            
            <a class="rnt-threshold-remove rnt-chevron-orange" style="margin-right: 4px;"><i class="fa-solid fa-chevron-right rnt-chevron-icon"></i></a>
            <a class="rnt-threshold-remove" data-action="removeThreshold" data-index="{{i}}" data-tooltip="{{localize 'pf2e-aztecs-rip-n-tear.removeThreshold'}}"><i class="fa-solid fa-trash"></i></a>
         </summary>

         <div class="rnt-threshold-subsection">
            <div class="rnt-subsection-title">
               <span class="rnt-section-title-flex">{{localize "pf2e-aztecs-rip-n-tear.linkedPartsHeader"}}</span>
               <i class="fa-solid fa-circle-info rnt-info" data-tooltip="{{localize 'pf2e-aztecs-rip-n-tear.linkedPartsTooltip'}}"></i>
            </div>
            <select class="rnt-threshold-part-select" data-ti="{{i}}">
               <option value="" disabled selected>{{localize "pf2e-aztecs-rip-n-tear.addBodyPartOpt"}}</option>
               {{#each @root.parts as |otherPart|}}
                  {{#unless (eq otherPart.id @root.part.id)}}
                  <option value="{{otherPart.id}}">{{otherPart.name}}</option>
                  {{/unless}}
               {{/each}}
            </select>
            {{#if t.linkedPartsData.length}}
            <div class="rnt-chip-list">
               {{#each t.linkedPartsData as |lp lpi|}}
               <span class="rnt-chip">
                  {{lp.name}}
                  <input type="hidden" name="thresholds.{{i}}.linkedParts" value="{{lp.id}}">
                  <a class="rnt-chip-remove" data-action="removeThresholdPart" data-ti="{{i}}" data-lpi="{{lpi}}"><i class="fa-solid fa-times"></i></a>
               </span>
               {{/each}}
            </div>
            {{/if}}
         </div>

         <div class="rnt-threshold-subsection">
            <div class="rnt-subsection-title">
               <span class="rnt-section-title-flex">{{localize "pf2e-aztecs-rip-n-tear.conditions"}}</span>
               <a class="rnt-action-link rnt-action-add rnt-subsection-title-actions" data-action="addCondition" data-ti="{{i}}"><i class="fa-solid fa-plus"></i> {{localize "pf2e-aztecs-rip-n-tear.addCondition"}}</a>
            </div>
            {{#each t.conditions as |c ci|}}
            <div style="display: flex; flex-direction: column; gap: 4px; margin-bottom: 4px; padding-bottom: 4px; border-bottom: 1px solid rgba(0,0,0,0.1);">
               <div class="rnt-repeat-row" style="margin-bottom: 0; border: none;">
                  <img class="rnt-repeat-icon" src="systems/pf2e/icons/conditions/{{c.slug}}.webp" onerror="this.src='icons/svg/hazard.svg';" />
                  <select class="rnt-condition-select" name="thresholds.{{i}}.conditions.{{ci}}.slug" style="flex: 2;">
                     {{#each @root.pf2eConditions}}<option value="{{this.slug}}" {{#if (eq c.slug this.slug)}}selected{{/if}}>{{this.name}}</option>{{/each}}
                  </select>
                  {{#if c.hasValue}}
                  <input type="number" name="thresholds.{{i}}.conditions.{{ci}}.value" value="{{c.value}}" placeholder="Lvl" class="rnt-input-tiny" />
                  {{else}}
                  <input type="hidden" name="thresholds.{{i}}.conditions.{{ci}}.value" value="1" />
                  {{/if}}
                  <a class="rnt-repeat-remove" data-action="removeCondition" data-ti="{{i}}" data-ci="{{ci}}"><i class="fa-solid fa-trash"></i></a>
               </div>
               <div style="display: flex; gap: 4px; align-items: center; padding-left: 32px; font-size: 0.85em;">
                  <label>Duration:</label>
                  <input type="number" class="rnt-input-tiny" name="thresholds.{{i}}.conditions.{{ci}}.durationValue" value="{{c.durationValue}}" placeholder="∞" />
                  <select class="rnt-input-tiny" name="thresholds.{{i}}.conditions.{{ci}}.durationUnit" style="width: auto;">
                     <option value="" {{#if (eq c.durationUnit "")}}selected{{/if}}>Unlimited</option>
                     <option value="rounds" {{#if (eq c.durationUnit "rounds")}}selected{{/if}}>Rounds</option>
                     <option value="minutes" {{#if (eq c.durationUnit "minutes")}}selected{{/if}}>Minutes</option>
                     <option value="hours" {{#if (eq c.durationUnit "hours")}}selected{{/if}}>Hours</option>
                     <option value="days" {{#if (eq c.durationUnit "days")}}selected{{/if}}>Days</option>
                  </select>
               </div>
            </div>
            {{/each}}
         </div>

         <div class="rnt-threshold-subsection">
            <div class="rnt-subsection-title">
               <span class="rnt-section-title-flex">{{localize "pf2e-aztecs-rip-n-tear.effects"}}</span>
               <a class="rnt-action-link rnt-action-add rnt-subsection-title-actions" data-action="addEffect" data-ti="{{i}}"><i class="fa-solid fa-plus"></i> {{localize "pf2e-aztecs-rip-n-tear.addEffect"}}</a>
            </div>
            {{#each t.effects as |e ei|}}
            <div style="display: flex; flex-direction: column; gap: 4px; margin-bottom: 4px; padding-bottom: 4px; border-bottom: 1px solid rgba(0,0,0,0.1);">
               <div class="rnt-repeat-row effect-entry" style="margin-bottom: 0; border: none;">
                  <img class="rnt-repeat-icon effect-icon" src="{{#if e.img}}{{e.img}}{{else}}icons/svg/mystery-man.svg{{/if}}" onerror="this.src='icons/svg/mystery-man.svg';" />
                  <input type="text" class="rnt-effect-uuid-input" name="thresholds.{{i}}.effects.{{ei}}.uuid" value="{{e.uuid}}" placeholder="Drag effect or paste UUID..." style="flex: 2;" />
                  <input type="hidden" name="thresholds.{{i}}.effects.{{ei}}.name" value="{{e.name}}" />
                  <input type="hidden" name="thresholds.{{i}}.effects.{{ei}}.img" value="{{e.img}}" />
                  <input type="hidden" name="thresholds.{{i}}.effects.{{ei}}.invalid" value="{{e.invalid}}" />
                  <div class="rnt-repeat-name effect-name-container">
                     {{#if e.invalid}}
                     <span class="rnt-invalid"><i class="fa-solid fa-triangle-exclamation"></i> {{localize "pf2e-aztecs-rip-n-tear.invalidEffect"}}</span>
                     {{else if e.uuid}}
                     <a class="content-link rnt-effect-link" data-uuid="{{e.uuid}}"><i class="fa-solid fa-suitcase"></i> {{e.name}}</a>
                     {{else}}
                     <span class="rnt-pending">{{localize "pf2e-aztecs-rip-n-tear.pending"}}</span>
                     {{/if}}
                  </div>
                  <a class="rnt-repeat-remove" data-action="removeEffect" data-ti="{{i}}" data-ei="{{ei}}"><i class="fa-solid fa-trash"></i></a>
               </div>
               <div style="display: flex; gap: 4px; align-items: center; padding-left: 32px; font-size: 0.85em;">
                  <label>Duration:</label>
                  <input type="number" class="rnt-input-tiny" name="thresholds.{{i}}.effects.{{ei}}.durationValue" value="{{e.durationValue}}" placeholder="∞" />
                  <select class="rnt-input-tiny" name="thresholds.{{i}}.effects.{{ei}}.durationUnit" style="width: auto;">
                     <option value="" {{#if (eq e.durationUnit "")}}selected{{/if}}>Unlimited</option>
                     <option value="rounds" {{#if (eq e.durationUnit "rounds")}}selected{{/if}}>Rounds</option>
                     <option value="minutes" {{#if (eq e.durationUnit "minutes")}}selected{{/if}}>Minutes</option>
                     <option value="hours" {{#if (eq e.durationUnit "hours")}}selected{{/if}}>Hours</option>
                     <option value="days" {{#if (eq e.durationUnit "days")}}selected{{/if}}>Days</option>
                  </select>
               </div>
            </div>
            {{/each}}
         </div>

         <div class="rnt-threshold-subsection">
            <div class="rnt-subsection-title">
               <span class="rnt-section-title-flex">{{localize "pf2e-aztecs-rip-n-tear.macros"}}</span>
               <a class="rnt-action-link rnt-action-add rnt-subsection-title-actions" data-action="addMacro" data-ti="{{i}}"><i class="fa-solid fa-plus"></i> {{localize "pf2e-aztecs-rip-n-tear.addMacro"}}</a>
            </div>
            {{#each t.macros as |m mi|}}
            <div class="rnt-repeat-row effect-entry">
               <img class="rnt-repeat-icon effect-icon" src="{{#if m.img}}{{m.img}}{{else}}icons/svg/dice-target.svg{{/if}}" onerror="this.src='icons/svg/dice-target.svg';" />
               <input type="text" class="rnt-effect-uuid-input" name="thresholds.{{i}}.macros.{{mi}}.uuid" value="{{m.uuid}}" placeholder="{{localize 'pf2e-aztecs-rip-n-tear.macroUuidPh'}}" style="flex: 2;" />
               <input type="hidden" name="thresholds.{{i}}.macros.{{mi}}.name" value="{{m.name}}" />
               <input type="hidden" name="thresholds.{{i}}.macros.{{mi}}.img" value="{{m.img}}" />
               <input type="hidden" name="thresholds.{{i}}.macros.{{mi}}.invalid" value="{{m.invalid}}" />
               <div class="rnt-repeat-name effect-name-container">
                  {{#if m.invalid}}
                  <span class="rnt-invalid"><i class="fa-solid fa-triangle-exclamation"></i> {{localize "pf2e-aztecs-rip-n-tear.invalidMacro"}}</span>
                  {{else if m.uuid}}
                  <a class="content-link rnt-effect-link" data-uuid="{{m.uuid}}"><i class="fa-solid fa-code"></i> {{m.name}}</a>
                  {{else}}
                  <span class="rnt-pending">{{localize "pf2e-aztecs-rip-n-tear.pending"}}</span>
                  {{/if}}
               </div>
               <a class="rnt-repeat-remove" data-action="removeMacro" data-ti="{{i}}" data-mi="{{mi}}"><i class="fa-solid fa-trash"></i></a>
            </div>
            {{/each}}
         </div>

         <div class="rnt-threshold-subsection">
            <div class="rnt-subsection-title">
               <span class="rnt-section-title-flex">{{localize "pf2e-aztecs-rip-n-tear.ruleElements"}}</span>
               <a class="rnt-action-link rnt-action-add rnt-subsection-title-actions" data-action="addRuleElement" data-ti="{{i}}"><i class="fa-solid fa-plus"></i> {{localize "pf2e-aztecs-rip-n-tear.addRuleElement"}}</a>
            </div>
            {{#each t.ruleElements as |re rei|}}
            <div style="display: flex; flex-direction: column; gap: 4px; margin-bottom: 4px; padding-bottom: 4px; border-bottom: 1px solid rgba(0,0,0,0.1);">
               <div class="rnt-repeat-row rnt-repeat-row-stretch re-entry" style="margin-bottom: 0; border: none;">
                  <textarea class="rnt-re-json-input" name="thresholds.{{i}}.ruleElements.{{rei}}.json" style="flex: 1;">{{re.json}}</textarea>
                  <input type="hidden" name="thresholds.{{i}}.ruleElements.{{rei}}.invalid" value="{{re.invalid}}" />
                  <a class="rnt-repeat-remove" data-action="removeRuleElement" data-ti="{{i}}" data-rei="{{rei}}"><i class="fa-solid fa-trash"></i></a>
               </div>
               <div style="display: flex; gap: 4px; align-items: center; padding-left: 4px; font-size: 0.85em;">
                  <label>Duration:</label>
                  <input type="number" class="rnt-input-tiny" name="thresholds.{{i}}.ruleElements.{{rei}}.durationValue" value="{{re.durationValue}}" placeholder="∞" />
                  <select class="rnt-input-tiny" name="thresholds.{{i}}.ruleElements.{{rei}}.durationUnit" style="width: auto;">
                     <option value="" {{#if (eq re.durationUnit "")}}selected{{/if}}>Unlimited</option>
                     <option value="rounds" {{#if (eq re.durationUnit "rounds")}}selected{{/if}}>Rounds</option>
                     <option value="minutes" {{#if (eq re.durationUnit "minutes")}}selected{{/if}}>Minutes</option>
                     <option value="hours" {{#if (eq re.durationUnit "hours")}}selected{{/if}}>Hours</option>
                     <option value="days" {{#if (eq re.durationUnit "days")}}selected{{/if}}>Days</option>
                  </select>
               </div>
               <div style="display: flex; gap: 4px; align-items: flex-start; padding-left: 4px; font-size: 0.85em; margin-top: 4px;">
                  <label style="margin-top: 4px;">Description:</label>
                  <textarea class="rnt-input-tiny" style="flex: 1; width: auto; resize: vertical;" rows="3" name="thresholds.{{i}}.ruleElements.{{rei}}.customDescription" placeholder="Rule Element">{{re.customDescription}}</textarea>
               </div>
            </div>
            {{/each}}
         </div>

         <div class="rnt-threshold-subsection">
            <div class="rnt-subsection-title">
               <span class="rnt-section-title-flex">{{localize "pf2e-aztecs-rip-n-tear.damages"}}</span>
               <a class="rnt-action-link rnt-action-add rnt-subsection-title-actions" data-action="addDamage" data-ti="{{i}}"><i class="fa-solid fa-plus"></i> {{localize "pf2e-aztecs-rip-n-tear.addDamage"}}</a>
            </div>
            {{#each t.damages as |d di|}}
            <div class="rnt-damage-row">
               <input type="number" name="thresholds.{{i}}.damages.{{di}}.diceNum" value="{{d.diceNum}}" />
               <span class="rnt-dice-sep">d</span>
               <select name="thresholds.{{i}}.damages.{{di}}.diceStep">
                  <option value="" {{#if (eq d.diceStep "")}}selected{{/if}}>-</option>
                  <option value="4" {{#if (eq d.diceStep "4")}}selected{{/if}}>4</option>
                  <option value="6" {{#if (eq d.diceStep "6")}}selected{{/if}}>6</option>
                  <option value="8" {{#if (eq d.diceStep "8")}}selected{{/if}}>8</option>
                  <option value="10" {{#if (eq d.diceStep "10")}}selected{{/if}}>10</option>
                  <option value="12" {{#if (eq d.diceStep "12")}}selected{{/if}}>12</option>
               </select>
               <select name="thresholds.{{i}}.damages.{{di}}.dmgType">
                  {{#each @root.pf2eDamageTypes}}<option value="{{this.slug}}" {{#if (eq d.dmgType this.slug)}}selected{{/if}}>{{this.label}}</option>{{/each}}
               </select>
               <select class="rnt-dmg-cat-select" name="thresholds.{{i}}.damages.{{di}}.dmgCategory">
                  {{#if (eq d.dmgType "bleed")}}
                  <option value="persistent" selected>{{localize "pf2e-aztecs-rip-n-tear.persistent"}}</option>
                  {{else}}
                  <option value="" {{#if (eq d.dmgCategory "")}}selected{{/if}}>{{localize "pf2e-aztecs-rip-n-tear.normal"}}</option>
                  <option value="persistent" {{#if (eq d.dmgCategory "persistent")}}selected{{/if}}>{{localize "pf2e-aztecs-rip-n-tear.persistent"}}</option>
                  <option value="precision" {{#if (eq d.dmgCategory "precision")}}selected{{/if}}>{{localize "pf2e-aztecs-rip-n-tear.precision"}}</option>
                  <option value="splash" {{#if (eq d.dmgCategory "splash")}}selected{{/if}}>{{localize "pf2e-aztecs-rip-n-tear.splash"}}</option>
                  {{/if}}
               </select>
               <a class="rnt-repeat-remove" data-action="removeDamage" data-ti="{{i}}" data-di="{{di}}"><i class="fa-solid fa-trash"></i></a>
            </div>
            {{/each}}
         </div>
      </details>
      {{/each}}
   </div>

</div>
<div class="rnt-footer">
   <button type="button" class="rnt-btn-primary rnt-btn-block" data-action="saveChanges">
      <i class="fa-solid fa-save"></i> {{localize "pf2e-aztecs-rip-n-tear.save"}}
   </button>
</div>
</form>
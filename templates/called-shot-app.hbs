<div class="rnt-called-shot-wrapper" style="display: flex; flex-direction: column; height: 100%;">
   <div class="rnt-scrollable">
      <button type="button" class="rnt-btn rnt-btn-primary rnt-btn-block" data-action="selectMain">
         <i class="fa-solid fa-crosshairs"></i> {{localize "pf2e-aztecs-rip-n-tear.targetCreature"}}
      </button>

      <hr>

      <div class="rnt-called-shot-list">
         {{#each parts}}
         <label class="rnt-called-shot-row {{#if this.isDestroyed}}rnt-destroyed{{/if}}">
            <input type="radio" name="rnt-part-select" value="{{this.id}}" {{#if this.checked}}checked{{/if}} {{#if this.isDestroyed}}disabled{{/if}}>
            <span class="rnt-called-shot-name">
               {{this.name}}
               {{#if ../isSave}}
               <span class="rnt-called-shot-info">{{../saveType}}: {{this.saveMod}}</span>
            {{else}}{{#if ../showAc}}
               <span class="rnt-called-shot-info">{{localize "pf2e-aztecs-rip-n-tear.ac"}}: {{this.acDisplay}}</span>
               {{/if}}{{/if}}
            </span>
            <span class="rnt-hp-state" style="color: {{this.hpColor}};">
               {{this.hpDisplay}}
            </span>
            </label>
         {{/each}}
      </div>
   </div>
   <div class="rnt-footer">
      <button type="button" class="rnt-btn-primary rnt-btn-block" data-action="selectPart">
         <i class="fa-solid fa-bullseye"></i> {{#if isSave}}{{localize "pf2e-aztecs-rip-n-tear.rollSave"}}{{else}}{{localize "pf2e-aztecs-rip-n-tear.calledShot"}}{{/if}}
      </button>
   </div>
</div>

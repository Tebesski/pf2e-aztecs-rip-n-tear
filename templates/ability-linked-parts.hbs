<div class="rnt-scrollable">
   <div class="rnt-section">
      <div class="rnt-section-title">
         <i class="fa-solid fa-link rnt-section-title-icon"></i>
         {{itemName}} — {{localize "pf2e-aztecs-rip-n-tear.linkedBodyParts"}}
      </div>
      {{#if parts.length}}
      <div class="rnt-linked-items-list">
         {{#each parts}}
         <div class="rnt-linked-item-row {{#if this.isDestroyed}}rnt-disabled{{/if}}">
            <a class="rnt-linked-name" data-action="openPart" data-part-id="{{this.id}}">
               <i class="fa-solid fa-bone"></i> {{this.name}}
               <span style="color: var(--rnt-text-muted); font-weight: normal; font-size: 0.85em; margin-left: 6px;">(HP: {{this.hp}} / {{this.max}})</span>
            </a>
         </div>
         {{/each}}
      </div>
      {{else}}
      <div class="rnt-empty">{{localize "pf2e-aztecs-rip-n-tear.noLinkedParts"}}</div>
      {{/if}}
   </div>
</div>

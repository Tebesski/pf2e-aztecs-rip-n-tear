<div class="rnt-scrollable" style="display: grid; gap: 8px;">
   <button type="button" class="rnt-btn-primary rnt-btn-block" data-action="addFrom">
      <i class="fa-solid fa-arrow-down-to-bracket"></i> {{localize "pf2e-aztecs-rip-n-tear.tplAddFrom"}}
   </button>
   <button type="button" class="rnt-btn rnt-btn-block" data-action="saveCurrent">
      <i class="fa-solid fa-floppy-disk"></i> {{localize "pf2e-aztecs-rip-n-tear.tplSave"}}
   </button>
   <button type="button" class="rnt-btn rnt-btn-block" data-action="exportTemplate">
      <i class="fa-solid fa-file-export"></i> {{localize "pf2e-aztecs-rip-n-tear.tplExport"}}
   </button>
   <button type="button" class="rnt-btn rnt-btn-block" data-action="importTemplate">
      <i class="fa-solid fa-file-import"></i> {{localize "pf2e-aztecs-rip-n-tear.tplImport"}}
   </button>
</div>
